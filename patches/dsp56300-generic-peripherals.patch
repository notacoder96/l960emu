+	void Jitmem::readExternalBus(DspValue& _dst, const JitReg32& _offset) const
+	{
+		{
+			const FuncArg r0(m_block, 0);
+			const FuncArg r1(m_block, 1);
+
+			auto assignArg = [this](const uint32_t _index, const JitRegGP& _d, const JitRegGP& _s)
+			{
+				if(_index == 0)
+					makeDspPtr(_d.as<JitReg64>());
+				else if(r32(_d) != r32(_s))
+					m_block.asm_().mov(r32(_d), r32(_s));
+			};
+
+			assignFuncArgs({r0, r1}, {regDspPtr, _offset}, assignArg);
+
+			m_block.stack().call(asmjit::func_as_ptr(&callDSPExternalBusRead));
+		}
+
+		if (!_dst.isRegValid())
+			_dst.temp(DspValue::Memory);
+
+		m_block.asm_().mov(r32(_dst.get()), r32(regReturnVal));
+	}
+
+	void Jitmem::readExternalBus(DspValue& _dst, const DspValue& _offset) const
+	{
+		if (_offset.isImm24())
+		{
+			readExternalBus(_dst, _offset.imm24());
+		}
+		else if(JitStackHelper::isFuncArg(_offset.get(), 2))
+		{
+			const RegGP offset(m_block);
+			m_block.asm_().mov(r32(offset), r32(_offset.get()));
+			readExternalBus(_dst, r32(offset));
+		}
+		else
+		{
+			readExternalBus(_dst, r32(_offset.get()));
+		}
+	}
